# Committed local-dev default — loaded by Vite in development mode
# (`npm run dev`). Because mode-specific env files win over the generic `.env`,
# these values override the prod-pointing `.env` symlink, so dev defaults to the
# LOCAL Supabase stack in every worktree. Production builds run in production
# mode and never load this file; `npm run dev:prod` opts back into prod.
#
# Boot the local stack with `npm run local:up` first (needs a running container
# runtime, e.g. OrbStack). See docs/runbooks/local-development-stack.md.
#
# Safe to commit: the URL is localhost and the anon key is the standard PUBLISHED
# local-dev key (a public client key by design). `npm run local:up` rewrites the
# anon key with the live value into the gitignored `.env.development.local`, so a
# stale key here is self-correcting — and the URL never points anywhere but
# 127.0.0.1, so this default can never silently hit production.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
VITE_SUPABASE_PROJECT_ID=local

# Auto sign-in as the seeded org admin so gated routes render without the login
# screen. These users are created by supabase/seed.sql (password: showflow-dev)
# and exist only in the local database. The autologin path is DEV-only
# (import.meta.env.DEV) and is stripped from production builds.
VITE_DEV_AUTOLOGIN=true
VITE_DEV_AUTOLOGIN_EMAIL=admin@example.com
VITE_DEV_AUTOLOGIN_PASSWORD=showflow-dev

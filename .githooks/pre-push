#!/usr/bin/env bash
#
# Pre-push hook — runs the Docker-free CI mirror (verify:fast) locally so the
# cheap layers (lint + mirror-sync, typecheck app+tools, build, unit tests +
# coverage, Deno checks + tests) fail on your machine instead of turning an
# open PR's GitHub CI red. An exact content fingerprint reuses a successful run.
#
# verify:fast is gated on an OPEN PR for the branch being pushed: while a branch
# is still pre-PR it is churned rapidly and CI has nothing to go red, so those
# pushes stay fast (secret scan only). Once a PR is open, GitHub CI runs the same
# suite on every push to the branch anyway (see .github/workflows/ci.yml,
# `pull_request: ["**"]`) — the local gate just lets you catch the failure before
# it lands on the PR. Detected via the `gh` CLI; if `gh` is absent or can't answer,
# the hook skips verify:fast (CI still gates the PR) rather than blocking the push.
#
# This is a convenience gate, NOT the source of truth. GitHub CI stays the
# enforced gate: it runs on the merged commit regardless, and the prod
# edge-function deploy keys off a green CI run (see .github/workflows). The hook
# only shortens the loop; it never makes CI skippable.
#
# The secret scan runs on EVERY push regardless of PR state — it is the cheap
# security gate that keeps a hardcoded credential off the remote.
#
# verify:full (pgTAP + Playwright, needs the Docker stack) is deliberately NOT
# run here — a container cold-start on every push would just train everyone to
# reach for --no-verify, and a bypassed hook protects nothing.
#
# Bypass when you need to (a WIP push on a PR branch, a docs-only branch):
#   git push --no-verify            # git skips every pre-push hook
#   SHOWFLOW_SKIP_VERIFY=1 git push # targeted skip, still logged
#
# Installed by the `prepare` npm script (git config core.hooksPath .githooks),
# so `npm ci` wires it up. Guarded by scripts/prePushHook.test.mjs.
set -uo pipefail

if [ "${SHOWFLOW_SKIP_VERIFY:-}" = "1" ]; then
  echo "pre-push: SHOWFLOW_SKIP_VERIFY=1 set — skipping verify:fast" >&2
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

# git feeds the ref-update lines on stdin, and stdin can only be read once — both
# the secret scan (--prepush) and the open-PR detection below need them, so
# capture once and replay to each. `$(cat)` strips only the trailing newline(s).
stdin_data="$(cat)"

# Secret scan first — cheapest possible fail, and the one that keeps a hardcoded
# credential (the Resend-key class of leak) off the remote. Runs on every push,
# independent of PR state. Mirrored by the CI "Lint" job so a --no-verify bypass
# is still caught server-side.
echo "pre-push: scanning pushed commits + tracked files for secrets…" >&2
# `|| exit 1` is load-bearing: the hook runs `set -uo pipefail` (no `-e`), so a
# bare failing statement would fall through and the hook would exit with a later
# command's code — pushing the secret anyway. Abort explicitly. --prepush consumes
# git's ref-update lines on stdin (replayed from the captured copy) and scans each
# pushed commit's diff, plus a tracked-tree snapshot.
printf '%s\n' "$stdin_data" | node scripts/scan-secrets.mjs --prepush || exit 1

# Does any branch in this push already have an open PR? verify:fast only gates
# those — a pre-PR branch push stays fast (secret scan only, above).
has_open_pr=0
if command -v gh >/dev/null 2>&1; then
  while read -r _local_ref local_sha remote_ref _remote_sha; do
    [ -z "${remote_ref:-}" ] && continue
    case "$remote_ref" in
      refs/heads/*) branch="${remote_ref#refs/heads/}" ;;
      *) continue ;; # tags and other non-branch refs never have a PR
    esac
    # A branch delete pushes the all-zero sha as the local sha — nothing to verify.
    case "${local_sha:-}" in ''|*[!0]*) : ;; *) continue ;; esac
    if gh pr list --head "$branch" --state open --json number --jq 'length' 2>/dev/null | grep -qE '^[1-9]'; then
      has_open_pr=1
      break
    fi
  done <<EOF
$stdin_data
EOF
else
  echo "pre-push: gh CLI not found — cannot check for an open PR; skipping verify:fast (CI still gates the PR)" >&2
fi

if [ "$has_open_pr" != "1" ]; then
  echo "pre-push: no open PR for the pushed branch — skipping verify:fast (CI runs it once a PR is open)" >&2
  exit 0
fi

# The branch has an open PR — run the local gate, reusing a matching cached result.
if node scripts/verify-cache.mjs check fast; then
  echo "pre-push: source snapshot already passed verify:fast — skipping duplicate suite" >&2
  exit 0
fi

echo "pre-push: open PR detected — running verify:fast (bypass with --no-verify or SHOWFLOW_SKIP_VERIFY=1)…" >&2
npm run --silent verify:fast
